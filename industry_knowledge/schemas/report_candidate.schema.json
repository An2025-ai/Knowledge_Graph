{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-atlas.dev/schemas/report_candidate.schema.json",
  "title": "Report Candidate",
  "description": "Schema for knowledge candidates extracted from industry reports (Section 4.7 of L2 spec).",
  "type": "object",
  "required": ["report_id", "requirement_id", "section", "statement", "knowledge_candidate_type", "citation_labels", "report_span"],
  "properties": {
    "report_id": {"type": "string"},
    "requirement_id": {"type": "string"},
    "section": {"type": "string"},
    "statement": {"type": "string"},
    "knowledge_candidate_type": {
      "type": "string",
      "enum": ["fact", "claim", "observation", "inference"]
    },
    "subject_candidates": {
      "type": "array",
      "items": {"type": "string"}
    },
    "relation_candidates": {
      "type": "array",
      "items": {"type": "string"}
    },
    "citation_labels": {
      "type": "array",
      "items": {"type": "string", "pattern": "^S[0-9]+$"},
      "minItems": 1
    },
    "report_span": {
      "type": "object",
      "required": ["start_line", "end_line"],
      "properties": {
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "normalized_statement_hash": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["candidate", "resolved", "verified", "promoted", "rejected", "duplicate"]
    }
  }
}
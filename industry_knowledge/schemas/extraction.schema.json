{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-atlas.dev/schemas/extraction.schema.json",
  "title": "Knowledge Extraction Output",
  "description": "Schema for structured knowledge extraction output from industry reports (Section 8.7 of L2 spec).",
  "type": "object",
  "required": ["report_id", "requirement_id", "entities", "relations", "statements", "extraction_model", "extracted_at"],
  "properties": {
    "report_id": {"type": "string"},
    "requirement_id": {"type": "string"},
    "report_span": {
      "type": "object",
      "properties": {
        "start_line": {"type": "integer"},
        "end_line": {"type": "integer"}
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_type", "canonical_name"],
        "properties": {
          "entity_type": {"type": "string"},
          "canonical_name": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "semantic_subtype": {"type": "string"},
          "attributes": {"type": "object"}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject_ref", "relation_type", "object_ref"],
        "properties": {
          "subject_ref": {"type": "string"},
          "relation_type": {"type": "string"},
          "object_ref": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "scope": {"type": "object"}
        }
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement", "statement_class"],
        "properties": {
          "statement": {"type": "string"},
          "statement_class": {
            "type": "string",
            "enum": ["fact", "claim", "observation", "inference"]
          },
          "subject_entity_ids": {"type": "array", "items": {"type": "string"}},
          "value": {"type": "object"},
          "time_period": {"type": "object"},
          "geography": {"type": "string"},
          "confidence": {"type": "number"}
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canonical_name": {"type": "string"},
          "parent_topic_ref": {"type": "string"},
          "related_intent_codes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_text": {"type": "string"},
          "intent_code": {"type": "string"}
        }
      }
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["citation_label", "source_record_id", "quote"],
        "properties": {
          "citation_label": {"type": "string", "pattern": "^S[0-9]+$"},
          "source_record_id": {"type": "string"},
          "quote": {"type": "string"},
          "content_path": {"type": "string"}
        }
      }
    },
    "extraction_model": {"type": "string"},
    "prompt_version": {"type": "string"},
    "extracted_at": {"type": "string", "format": "date-time"}
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-atlas.dev/schemas/research_report.schema.json",
  "title": "Research Report",
  "description": "Schema for geo-research generated industry reports (Section 4.4 of L2 spec). Defines the required chapter structure and citation format.",
  "type": "object",
  "required": ["report_id", "requirement_id", "run_id", "generated_at", "sections", "citation_index", "source_inventory"],
  "properties": {
    "report_id": {
      "type": "string",
      "description": "Unique report identifier"
    },
    "requirement_id": {
      "type": "string",
      "description": "Reference to the Industry Knowledge Requirement that drove this report"
    },
    "run_id": {
      "type": "string",
      "description": "geo-research run identifier for traceability"
    },
    "model": {
      "type": "string",
      "description": "LLM model used to generate the report"
    },
    "prompt_version": {
      "type": "string",
      "description": "Version of the report generation prompt"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sections": {
      "type": "array",
      "description": "Report sections in order",
      "items": {
        "type": "object",
        "required": ["section_code", "title", "content"],
        "properties": {
          "section_code": {
            "type": "string",
            "enum": [
              "scope_and_methodology", "industry_definition", "market_structure",
              "audience_and_decision", "problems_and_jtbd", "standard_capabilities",
              "decision_factors", "topics_and_questions", "market_facts",
              "policy_and_risks", "competition", "conflicts_and_unverified",
              "missing_data", "coverage_ledger", "source_inventory"
            ]
          },
          "title": {"type": "string"},
          "content": {"type": "string"},
          "citations": {
            "type": "array",
            "items": {"type": "string", "pattern": "^S[0-9]+$"}
          }
        }
      }
    },
    "citation_index": {
      "type": "array",
      "description": "Complete citation index mapping [S#] to sources",
      "items": {
        "type": "object",
        "required": ["label", "source_id", "url"],
        "properties": {
          "label": {"type": "string", "pattern": "^S[0-9]+$"},
          "source_id": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "source_class": {"type": "string"},
          "access_status": {
            "type": "string",
            "enum": ["crawled", "ok", "search-snippet", "robots-blocked", "paywall", "not_found", "redirected"]
          },
          "content_hash": {"type": "string"}
        }
      }
    },
    "source_inventory": {
      "type": "array",
      "description": "Complete inventory of all sources discovered",
      "items": {
        "type": "object",
        "required": ["source_id", "organization", "source_class", "url"],
        "properties": {
          "source_id": {"type": "string"},
          "organization": {"type": "string"},
          "official_domain": {"type": "string"},
          "source_class": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "l2_enabled": {"type": "boolean"},
          "discovered_by": {"type": "string"},
          "identity_verified": {"type": "boolean"},
          "methodology_available": {"type": "boolean"},
          "independence_level": {"type": "string", "enum": ["high", "medium", "low", "unknown"]}
        }
      }
    },
    "coverage_status": {
      "type": "object",
      "description": "Per-dimension coverage status",
      "additionalProperties": {
        "type": "string",
        "enum": ["covered_by_whitelist", "covered_by_extended_sources", "partial", "missing", "conflicting", "blocked", "not_applicable"]
      }
    },
    "validation_status": {
      "type": "string",
      "enum": ["pending", "passed", "failed_with_issues", "rejected"]
    }
  }
}
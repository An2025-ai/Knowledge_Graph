{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-atlas.dev/schemas/document.schema.json",
  "title": "L2 Document",
  "description": "Schema for L2 document and content entities (Section 6.9 of L2 spec).",
  "type": "object",
  "required": ["id", "type", "canonical_name", "content_type", "source_id"],
  "properties": {
    "id": {"type": "string"},
    "type": {"type": "string", "const": "content"},
    "canonical_name": {"type": "string"},
    "content_type": {
      "type": "string",
      "enum": [
        "article", "product_page", "whitepaper", "case_study",
        "video", "social_post", "report", "buyer_guide",
        "industry_report", "research_paper", "standard", "regulation",
        "financial_disclosure", "news_article", "other"
      ]
    },
    "source_id": {"type": "string"},
    "covered_topic_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "target_audience_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "published_at": {"type": "string", "format": "date"},
    "updated_at": {"type": "string", "format": "date-time"},
    "content_hash": {"type": "string"},
    "language": {"type": "string"},
    "market": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "author": {"type": "string"},
    "access_policy": {"type": "string"},
    "copyright_policy": {"type": "string"},
    "status": {"type": "string", "enum": ["active", "inactive", "deprecated"]},
    "version": {"type": "string"}
  }
}
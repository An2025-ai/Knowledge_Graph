{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-atlas.dev/schemas/context_package.schema.json",
  "title": "Context Package",
  "description": "Schema for L2 Context Builder response (Section 11 of L2 spec). Provides industry subgraph to downstream tasks.",
  "type": "object",
  "required": ["scope", "entities", "relations", "facts"],
  "properties": {
    "scope": {
      "type": "object",
      "properties": {
        "industry_id": {"type": "string"},
        "category_ids": {"type": "array", "items": {"type": "string"}},
        "market": {"type": "string"},
        "language": {"type": "string"},
        "snapshot_id": {"type": "string"},
        "generated_at": {"type": "string", "format": "date-time"}
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "entity_type", "canonical_name"],
        "properties": {
          "id": {"type": "string"},
          "entity_type": {"type": "string"},
          "canonical_name": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "semantic_subtype": {"type": "string"},
          "attributes": {"type": "object"}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject_id", "relation_type", "object_id"],
        "properties": {
          "subject_id": {"type": "string"},
          "relation_type": {"type": "string"},
          "object_id": {"type": "string"},
          "confidence": {"type": "number"},
          "verification_status": {"type": "string"},
          "scope": {"type": "object"}
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "statement_class": {"type": "string"},
          "verification_status": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "claimant_id": {"type": "string"},
          "stance": {"type": "string"},
          "evidence_level": {"type": "string"}
        }
      }
    },
    "topic_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic_id": {"type": "string"},
          "canonical_name": {"type": "string"},
          "parent_topic_id": {"type": "string"},
          "question_patterns": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "question_space": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_text": {"type": "string"},
          "intent_code": {"type": "string"},
          "decision_stage": {"type": "string"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {"type": "string"},
          "source_id": {"type": "string"},
          "citation_label": {"type": "string"},
          "quote": {"type": "string"},
          "support_status": {"type": "string"}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conflict_type": {"type": "string"},
          "party_a": {"type": "object"},
          "party_b": {"type": "object"},
          "resolution_status": {"type": "string"}
        }
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension": {"type": "string"},
          "reason": {"type": "string"},
          "impact": {"type": "string"}
        }
      }
    }
  }
}
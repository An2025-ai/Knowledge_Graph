{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-atlas.dev/schemas/industry_requirement.schema.json",
  "title": "Industry Knowledge Requirement",
  "description": "Schema for L2 industry knowledge requirement files (Section 4.2 of L2 spec). Defines the contract between L2 and geo-research for industry research tasks.",
  "type": "object",
  "required": ["requirement_id", "schema_version", "industry", "required_dimensions", "source_requirements", "report_contract"],
  "properties": {
    "requirement_id": {
      "type": "string",
      "description": "Unique requirement identifier, e.g. ikr_crm_cn_2026_v1",
      "pattern": "^ikr_[a-z]+_[a-z]{2}_[0-9]{4}_v[0-9]+$"
    },
    "schema_version": {
      "type": "string",
      "description": "Schema version of this requirement file",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "industry": {
      "type": "object",
      "required": ["industry_id", "category_ids", "market"],
      "properties": {
        "industry_id": {
          "type": "string",
          "description": "Industry entity ID, e.g. ind_enterprise_software"
        },
        "category_ids": {
          "type": "array",
          "description": "Category entity IDs to include",
          "items": {"type": "string"},
          "minItems": 1
        },
        "market": {
          "type": "string",
          "description": "Market region code, e.g. CN, US, EU, GLOBAL",
          "minLength": 2,
          "maxLength": 10
        },
        "languages": {
          "type": "array",
          "description": "Target languages",
          "items": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
          "default": ["zh-CN"]
        }
      }
    },
    "time_scope": {
      "type": "object",
      "properties": {
        "preferred_from": {"type": "string", "format": "date"},
        "fallback_from": {"type": "string", "format": "date"}
      }
    },
    "excluded_source_classes": {
      "type": "array",
      "description": "Source classes to exclude from this research",
      "items": {
        "type": "string",
        "enum": ["community", "social_media", "ugc_review", "forum", "creator_platform"]
      }
    },
    "required_dimensions": {
      "type": "array",
      "description": "Data dimensions that must be covered in the report",
      "items": {
        "type": "object",
        "required": ["dimension_code", "required", "questions", "expected_fields", "required_source_classes", "evidence_rules"],
        "properties": {
          "dimension_code": {
            "type": "string",
            "enum": [
              "market_definition", "category_structure", "market_participants",
              "audience_and_decision_chain", "problems_and_jobs", "use_cases",
              "capabilities", "decision_factors", "topics_and_questions",
              "market_facts_and_trends", "regulation_and_risks",
              "competition_structure", "source_ecology", "evidence_gaps"
            ]
          },
          "required": {"type": "boolean"},
          "questions": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "expected_fields": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "required_source_classes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "government", "regulator", "standards_body", "industry_association",
                "industry_research", "academic", "brokerage_research", "reliable_media",
                "competitor_official", "company_disclosure"
              ]
            }
          },
          "evidence_rules": {"type": "object"}
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "source_requirements": {
      "type": "object",
      "required": ["allowed_source_classes", "critical_claim_min_independent_sources"],
      "properties": {
        "primary_mode": {
          "type": "string",
          "enum": ["whitelist_first"],
          "default": "whitelist_first"
        },
        "fallback_discovery": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "trigger_on": {
              "type": "array",
              "items": {"type": "string", "enum": ["missing", "partial", "outdated", "conflicting"]}
            },
            "require_original_url": {"type": "boolean"},
            "require_selection_reason": {"type": "boolean"}
          }
        },
        "allowed_source_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "government", "regulator", "standards_body", "industry_association",
              "industry_research", "academic", "brokerage_research", "reliable_media",
              "competitor_official", "company_disclosure"
            ]
          }
        },
        "critical_claim_min_independent_sources": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        }
      }
    },
    "report_contract": {
      "type": "object",
      "required": ["format", "inline_citation_format"],
      "properties": {
        "format": {"type": "string", "enum": ["markdown"]},
        "inline_citation_format": {"type": "string", "enum": ["[S#]"]},
        "require_coverage_ledger": {"type": "boolean", "default": true},
        "require_evidence_package": {"type": "boolean", "default": true},
        "require_missing_data_section": {"type": "boolean", "default": true}
      }
    }
  }
}

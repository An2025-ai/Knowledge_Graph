{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brand Atlas",
  "version": "0.1.1",
  "identifier": "com.brandatlas.desktop",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/dev/dev-desktop.ps1",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Brand Atlas",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://127.0.0.1:*; connect-src 'self' ipc: http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/knowledge-engine"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-atlas.dev/schemas/l3_claim_policy.schema.json",
  "title": "L3 Claim Policy",
  "description": "Schema for L3 claim governance policies (Section 7.10 of L3 spec).",
  "type": "object",
  "required": ["tenant_id", "brand_id", "policy_type", "allowed_channels", "status"],
  "properties": {
    "tenant_id": {"type": "string"},
    "brand_id": {"type": "string"},
    "assertion_id": {"type": "string"},
    "normalized_phrase": {"type": "string"},
    "policy_type": {"type": "string", "enum": ["approved", "restricted", "prohibited"]},
    "allowed_channels": {
      "type": "array",
      "items": {"type": "string", "enum": ["internal_analysis", "customer_report", "public_content"]}
    },
    "required_qualifiers": {"type": "array", "items": {"type": "string"}},
    "approval_owner": {"type": "string"},
    "effective_from": {"type": "string", "format": "date"},
    "effective_to": {"type": "string", "format": "date"},
    "status": {"type": "string", "enum": ["active", "inactive", "deprecated"]}
  }
}
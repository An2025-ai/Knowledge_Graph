{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-atlas.dev/schemas/l3_evidence_span.schema.json",
  "title": "L3 Evidence Span",
  "description": "Schema for L3 evidence spans (Section 8.4/8.9 of L3 spec).",
  "type": "object",
  "required": ["evidence_id", "tenant_id", "brand_id", "source_id", "content_path", "quote", "support_status"],
  "properties": {
    "evidence_id": {"type": "string"},
    "tenant_id": {"type": "string"},
    "brand_id": {"type": "string"},
    "source_id": {"type": "string"},
    "document_id": {"type": "string"},
    "content_path": {"type": "string"},
    "start_offset": {"type": "integer"},
    "end_offset": {"type": "integer"},
    "quote": {"type": "string"},
    "page_ref": {"type": "string"},
    "support_status": {
      "type": "string",
      "enum": ["direct", "partial", "context_only", "contradictory", "not_found"]
    },
    "access_level": {"type": "string", "enum": ["public", "internal", "confidential", "restricted"]}
  }
}
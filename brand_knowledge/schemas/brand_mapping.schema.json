{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-atlas.dev/schemas/l3_brand_mapping.schema.json",
  "title": "L3 Brand Mapping",
  "description": "Schema for L3 brand-to-L2 mappings (Section 8.7 of L3 spec).",
  "type": "object",
  "required": ["tenant_id", "brand_id", "local_entity_id", "l2_entity_id", "mapping_type", "confidence", "review_status"],
  "properties": {
    "tenant_id": {"type": "string"},
    "brand_id": {"type": "string"},
    "local_entity_id": {"type": "string"},
    "l2_entity_id": {"type": "string"},
    "mapping_type": {"type": "string", "enum": ["exactMatch", "closeMatch", "broaderMatch"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "mapping_note": {"type": "string"},
    "review_status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
    "mapper_version": {"type": "string"}
  }
}